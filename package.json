{
  "name": "10000",
  "version": "1.3.0",
  "description": "10,000 (Farkle) dice game, single player in 3D and online multiplayer with friends",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test/game.test.js",
    "app:www": "node scripts/build-www.js",
    "app:sync": "npm run app:www && cap sync",
    "app:assets": "capacitor-assets generate --android --ios",
    "app:android": "npm run app:sync && cap open android",
    "app:ios": "npm run app:sync && cap open ios"
  },
  "keywords": [
    "game",
    "websocket",
    "dice"
  ],
  "author": "Devin Gaul",
  "license": "",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@fontsource/bruno-ace-sc": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "bootstrap": "5.3.3",
    "bootstrap-icons": "1.11.3",
    "cannon-es": "0.20.0",
    "express": "^4.21.2",
    "jquery": "3.7.1",
    "socket.io": "^4.8.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.1"
  }
}
